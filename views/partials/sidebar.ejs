<details class="dock" open>
  <summary class="dock__bar">
    <span class="dock__dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="dock__title">Our Companies</span>
    <svg class="dock__chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 15l6-6 6 6" fill="none" stroke="currentColor" stroke-width="2"/></svg>
  </summary>

  <nav class="dock__body" aria-label="Our companies">
    <ul class="companies">
      <% companies.forEach(function (c, i) { %>
        <li>
          <a class="company" href="<%= c.url %>"<% if (c.external) { %> target="_blank" rel="noopener noreferrer"<% } %>>
            <span class="company__num"><%= String(i + 1).padStart(2, '0') %></span>
            <span class="company__text">
              <span class="company__name"><%= c.name %></span>
              <span class="company__sector"><%= c.sector %></span>
            </span>
            <svg class="company__arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
          </a>
        </li>
      <% }) %>
    </ul>

    <div class="dock__foot">
      <a class="privacy" href="<%= site.privacyUrl %>">Privacy Policy</a>
      <span class="copy">&copy; <%= site.year %></span>
    </div>
  </nav>
</details>