<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Page not found | <%= site.name %></title>
  <meta name="robots" content="noindex">
  <meta name="theme-color" content="#0D0D0D">
  <link rel="icon" type="image/svg+xml" href="/img/logo-mark.svg">
  <link rel="preload" href="/fonts/neofolia.ttf" as="font" type="font/ttf" crossorigin>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="page-404">
  <a class="skip" href="#main">Skip to content</a>

  <%- include('partials/bg') %>
  <%- include('partials/header') %>

  <main id="main" class="nf">
    <div class="nf__code" aria-hidden="true">404</div>
    <p class="eyebrow">Lost in space</p>
    <h1 class="nf__title">This page drifted out of orbit.</h1>
    <p class="nf__text">The page you are looking for does not exist, has moved, or never left the drawing board.</p>
    <div class="actions">
      <a class="btn btn--primary" href="/">Back to Home</a>
      <a class="btn" href="/about">About Us</a>
    </div>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/hero.js" defer></script>
</body>
</html>